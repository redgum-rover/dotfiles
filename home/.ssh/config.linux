# SSH config — native Linux. Git auth uses the local 1Password SSH agent
# exposed by the 1Password Linux desktop app. The private key never lands
# on disk.
Host *
    IdentityAgent ~/.1password/agent.sock
    AddKeysToAgent yes

Host gitlab.com
    User git
    IdentitiesOnly yes

# Port 22 is often blocked on corporate networks; route GitHub SSH over the
# HTTPS port via GitHub's ssh.github.com:443 endpoint.
Host github.com
    User git
    HostName ssh.github.com
    Port 443
    IdentitiesOnly yes
