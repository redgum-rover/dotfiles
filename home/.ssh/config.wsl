# SSH config — WSL. Git auth uses the 1Password SSH agent running in the
# Windows desktop app, reached over a relay socket (see README for the
# one-time npiperelay setup). The private key never lands on disk.
Host *
    IdentityAgent ~/.1password/agent.sock
    AddKeysToAgent yes

Host gitlab.com
    User git
    IdentitiesOnly yes

Host github.com
    User git
    IdentitiesOnly yes
