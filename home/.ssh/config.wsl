# SSH config — WSL. Git auth uses the 1Password SSH agent running in the
# Windows desktop app, reached over a relay socket (see README for the
# one-time npiperelay setup). The private key never lands on disk.
Host *
    IdentityAgent ~/.1password/agent.sock
    AddKeysToAgent yes

Host gitlab.com
    User git
    IdentitiesOnly yes

# Port 22 is often blocked on corporate networks; route GitHub SSH over the
# HTTPS port via GitHub's ssh.github.com:443 endpoint. IdentityFile pins the
# 1Password-served key (public half) so the agent offers exactly that key,
# not any on-disk id_* identities.
Host github.com
    User git
    HostName ssh.github.com
    Port 443
    IdentitiesOnly yes
    IdentityFile ~/.ssh/redgum-rover.pub
